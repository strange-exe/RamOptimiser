<!-- RAM Optimiser window (redesign 2, option A "Windows native"). Loaded at runtime with XamlReader (no
     code-behind); AppShell finds the named elements and wires their events. Three tabs along the top, like
     Windows Settings and Task Manager: Memory, Startup, Settings. Reading order per tab is in design.md. -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:RamOptimiser.App;assembly=RamOptimiser"
        Title="RAM Optimiser" Width="460" MinWidth="440" MaxWidth="720" Height="720" MinHeight="480"
        ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource Surface}" Foreground="{DynamicResource Text}"
        FontFamily="{DynamicResource BodyFont}" FontSize="14"
        AutomationProperties.Name="RAM Optimiser">
  <Window.Resources>
    <!-- Auto-clean paused (P6): two bars, drawn like the icons in Styles.xaml. -->
    <Geometry x:Key="IconPause">M5.5,3.5 V12.5 M10.5,3.5 V12.5</Geometry>
  </Window.Resources>
  <TabControl x:Name="Tabs" AutomationProperties.Name="Sections">

    <!-- ============================== Memory ============================== -->
    <TabItem x:Name="MemoryTab" AutomationProperties.Name="Memory" ToolTip="Memory (Ctrl+1)" AutomationProperties.AcceleratorKey="Ctrl+1">
      <TabItem.Header>
        <StackPanel Orientation="Horizontal">
          <Path Style="{StaticResource IconPath}" Data="{StaticResource IconMemory}" Margin="0,0,8,0"
                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
          <TextBlock Text="Memory" VerticalAlignment="Center"/>
        </StackPanel>
      </TabItem.Header>
      <ScrollViewer x:Name="MainView" Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16,12,16,16">
          <!-- Sample failed. A polite live region (U9): read out when it appears or its message changes, never on each
               2-second sample. -->
          <app:LiveRegion x:Name="SampleError" Style="{StaticResource InfoBar}" Margin="0,0,0,8" Visibility="Collapsed"
                          AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Memory status could not be read.">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Path Style="{StaticResource IconPath}" Data="{StaticResource IconError}" Stroke="{DynamicResource Danger}"
                    VerticalAlignment="Top" Margin="0,1,8,0"/>
              <TextBlock x:Name="SampleErrorText" Grid.Column="1" TextWrapping="Wrap" FontSize="13" Margin="0,0,6,0"
                         Text="Memory status could not be read."/>
            </Grid>
          </app:LiveRegion>

          <!-- Auto-clean paused or waiting longer (P6, R2): seen without scrolling to the auto-clean card. Shares the
               slot with the bar above, which wins while memory cannot be read. Glyph plus words, never colour alone;
               the info tint (NoticeBar) sets it apart from the danger-tinted error bar. A pause says where it came from. -->
          <app:LiveRegion x:Name="AutoBar" Style="{StaticResource NoticeBar}" Margin="0,0,0,8" Visibility="Collapsed"
                          AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Auto-clean">
            <app:LiveRegion.RenderTransform>
              <TranslateTransform/>
            </app:LiveRegion.RenderTransform>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Path x:Name="AutoBarGlyph" Style="{StaticResource IconPath}" VerticalAlignment="Top" Margin="0,1,8,0"/>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="AutoBarTitle" TextWrapping="Wrap" FontSize="13"/>
                <TextBlock x:Name="AutoBarDetail" Style="{StaticResource Small}" Visibility="Collapsed"/>
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="AutoBarResume" Style="{StaticResource OutlineButton}" Content="Resume" Margin="8,0,4,0"
                        Visibility="Collapsed" AutomationProperties.Name="Resume auto-clean"/>
                <Button x:Name="AutoBarDismiss" Style="{StaticResource SubtleButton}" Margin="4,-4,0,0" Visibility="Collapsed"
                        AutomationProperties.Name="Dismiss the auto-clean wait message">
                  <Path Style="{StaticResource IconPath}" Data="{StaticResource IconClose}" Stroke="{DynamicResource Text}"/>
                </Button>
              </StackPanel>
            </Grid>
          </app:LiveRegion>

          <!-- 1. Load, memory map, legend, commit charge -->
          <Border Style="{StaticResource CardBorder}" Padding="16,12,16,14">
            <StackPanel>
              <app:SummaryPanel x:Name="LoadCard" AutomationProperties.Name="Memory load">
                <TextBlock Typography.NumeralAlignment="Tabular" TextOptions.TextFormattingMode="Ideal" TextWrapping="Wrap"><Run
                    x:Name="LoadNumber" Text="--" FontFamily="{DynamicResource DisplayFont}" FontSize="44" FontWeight="SemiBold"/><Run
                    Text="%" FontFamily="{DynamicResource DisplayFont}" FontSize="28" FontWeight="SemiBold"/><Run
                    Text="   " FontSize="14"/><Run x:Name="InUseRun" Text="Reading memory..." FontSize="14" Foreground="{DynamicResource MutedText}"/></TextBlock>
              </app:SummaryPanel>
              <!-- While sampling fails after a good read: when the figures were last read -->
              <TextBlock x:Name="LastReadNote" Style="{StaticResource Small}" Margin="0,2,0,0" Visibility="Collapsed"/>

              <!-- Memory map: one bar for the whole of RAM; the ring is a 3:1 edge over the parts. -->
              <Grid Height="24" Margin="0,10,0,0">
                <app:MapPanel x:Name="MapBar" Background="{DynamicResource Card}" Gap="2" Radius="4"
                              AutomationProperties.Name="Memory map">
                  <Border x:Name="SegInUse" Background="{DynamicResource MapInUse}"/>
                  <Border x:Name="SegModified" Background="{DynamicResource MapModified}"/>
                  <Border x:Name="SegStandby" Background="{DynamicResource MapStandby}"/>
                  <Border x:Name="SegFree" Background="{DynamicResource MapFree}"/>
                </app:MapPanel>
                <Border CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource ControlBorder}" IsHitTestVisible="False"/>
              </Grid>
              <TextBlock x:Name="ListsNote" Style="{StaticResource Small}" Margin="0,8,0,0" Visibility="Collapsed"/>

              <!-- Legend: 2 x 2, in the map's left-to-right order read down each column -->
              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="20"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <app:SummaryPanel x:Name="RowInUse" Padding="0,2">
                  <DockPanel>
                    <Border DockPanel.Dock="Left" Style="{StaticResource Swatch}" Background="{DynamicResource MapInUse}"/>
                    <TextBlock x:Name="ValInUse" DockPanel.Dock="Right" Style="{StaticResource FigureText}"/>
                    <TextBlock Text="In use" VerticalAlignment="Center"/>
                  </DockPanel>
                </app:SummaryPanel>
                <app:SummaryPanel x:Name="RowModified" Grid.Row="1" Padding="0,2">
                  <DockPanel>
                    <Border DockPanel.Dock="Left" Style="{StaticResource Swatch}" Background="{DynamicResource MapModified}"/>
                    <TextBlock x:Name="ValModified" DockPanel.Dock="Right" Style="{StaticResource FigureText}"/>
                    <TextBlock Text="Modified" VerticalAlignment="Center"/>
                  </DockPanel>
                </app:SummaryPanel>
                <app:SummaryPanel x:Name="RowStandby" Grid.Column="2" Padding="0,2">
                  <DockPanel>
                    <Border DockPanel.Dock="Left" Style="{StaticResource Swatch}" Background="{DynamicResource MapStandby}"/>
                    <TextBlock x:Name="ValStandby" DockPanel.Dock="Right" Style="{StaticResource FigureText}"/>
                    <TextBlock Text="Standby" VerticalAlignment="Center"/>
                  </DockPanel>
                </app:SummaryPanel>
                <app:SummaryPanel x:Name="RowFree" Grid.Row="1" Grid.Column="2" Padding="0,2">
                  <DockPanel>
                    <Border DockPanel.Dock="Left" Style="{StaticResource Swatch}" Background="{DynamicResource MapFree}"/>
                    <TextBlock x:Name="ValFree" DockPanel.Dock="Right" Style="{StaticResource FigureText}"/>
                    <TextBlock x:Name="FreeLabel" Text="Free" VerticalAlignment="Center"/>
                  </DockPanel>
                </app:SummaryPanel>
              </Grid>

              <!-- Commit charge: what apps have reserved, which cleaning cannot lower -->
              <Border Style="{StaticResource RowDivider}" Margin="0,12,0,0" Padding="0,12,0,0">
                <StackPanel>
                  <app:SummaryPanel x:Name="CommitRow" AutomationProperties.Name="Committed">
                    <DockPanel>
                      <TextBlock x:Name="CommitValue" DockPanel.Dock="Right" Style="{StaticResource FigureText}"/>
                      <TextBlock Text="Committed" VerticalAlignment="Center"/>
                    </DockPanel>
                  </app:SummaryPanel>
                  <Grid Height="4" Margin="0,6,0,0">
                    <app:MapPanel x:Name="CommitBar" Background="{DynamicResource TrackBackground}" Gap="0" Radius="2">
                      <Border x:Name="CommitUsed" Background="{DynamicResource Accent}"/>
                      <Border x:Name="CommitRest" Background="{DynamicResource TrackBackground}"
                              BorderBrush="{DynamicResource TrackEdge}" BorderThickness="1"/>
                    </app:MapPanel>
                  </Grid>
                  <TextBlock x:Name="CommitNote" Style="{StaticResource Small}" Margin="0,6,0,0"
                             Text="Reserved by apps. The limit includes the page file, and cleaning does not lower it."/>
                  <!-- U15: at 90% of the limit (off again below 87%) the bar turns Caution and this line replaces the
                       note above: glyph plus words in Text colour, read out once when it appears. No red. -->
                  <app:LiveRegion x:Name="CommitWarning" Visibility="Collapsed" Margin="0,6,0,0"
                                  AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Close to the limit">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <Path Style="{StaticResource IconPath}" Data="{StaticResource IconWarn}" Stroke="{DynamicResource Caution}"
                            VerticalAlignment="Top" Margin="0,0,6,0"/>
                      <TextBlock x:Name="CommitWarningText" Grid.Column="1" Style="{StaticResource Small}" Foreground="{DynamicResource Text}"/>
                    </Grid>
                  </app:LiveRegion>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <!-- 2. Clean memory -->
          <!-- Disabled, it still shows why on hover (U21); the reason is also the visible admin line below. -->
          <Button x:Name="CleanButton" Style="{StaticResource PrimaryButton}" Margin="0,12,0,0" Content="Clean memory"
                  ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Clean memory"/>
          <TextBlock x:Name="PowerNote" Style="{StaticResource Small}" Margin="4,6,4,0" Visibility="Collapsed"/>

          <!-- One admin line when not elevated -->
          <StackPanel x:Name="AdminLine" Margin="4,6,0,0" Visibility="Collapsed">
            <WrapPanel>
              <TextBlock x:Name="ElevationText" Style="{StaticResource Muted}" TextWrapping="NoWrap" VerticalAlignment="Center"
                         Margin="0,0,4,0" Text="Needs administrator rights to clean."/>
              <Button x:Name="RestartButton" Style="{StaticResource LinkButton}" Content="Restart as administrator"
                      AutomationProperties.Name="Restart as administrator"/>
            </WrapPanel>
            <!-- Assertive (U9): the restart failed and the user has to act. -->
            <app:LiveRegion x:Name="RestartErrorRegion" Visibility="Collapsed" Margin="0,6,0,0"
                            AutomationProperties.LiveSetting="Assertive" AutomationProperties.Name="Restart failed">
              <TextBlock x:Name="RestartError" TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Danger}"/>
            </app:LiveRegion>
          </StackPanel>
          <!-- Elevated as another account (over-the-shoulder UAC): stays for the whole run -->
          <TextBlock x:Name="AccountNotice" Style="{StaticResource Small}" Margin="4,6,4,0" TextWrapping="Wrap"
                     Visibility="Collapsed"/>

          <!-- Will a clean help now (R1): Windows' own low/high memory signal and the commit level, as glyph plus words.
               Display only: it never gates auto-clean. Shown only on live figures; changes after two equal samples. -->
          <Grid x:Name="AdviceLine" Margin="4,8,4,0" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Path x:Name="AdviceGlyph" Style="{StaticResource IconPath}" VerticalAlignment="Top" Margin="0,1,8,0"/>
            <TextBlock x:Name="AdviceText" Grid.Column="1" FontSize="13" TextWrapping="Wrap"/>
          </Grid>

          <!-- 3. The last clean, manual or automatic (announced politely to screen readers) -->
          <app:LiveRegion x:Name="ResultPanel" Margin="4,8,0,0" Visibility="Collapsed"
                          AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Last clean">
            <app:LiveRegion.RenderTransform>
              <TranslateTransform/>
            </app:LiveRegion.RenderTransform>
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Path x:Name="ResultGlyph" Style="{StaticResource IconPath}" Data="{StaticResource IconCheck}"
                      Stroke="{DynamicResource Ok}" VerticalAlignment="Top" Margin="0,1,8,0"/>
                <TextBlock x:Name="ResultText" Grid.Column="1" Style="{StaticResource Muted}"/>
              </Grid>
              <Expander x:Name="ResultDetails" Style="{StaticResource Disclosure}" Margin="20,2,0,0" Header="Show areas"
                        AutomationProperties.Name="Results by area">
                <Border Style="{StaticResource CardBorder}" Margin="0,4,0,0" Padding="12,2">
                  <StackPanel x:Name="ResultRows"/>
                </Border>
              </Expander>
            </StackPanel>
          </app:LiveRegion>

          <!-- 4. Top apps -->
          <Border Style="{StaticResource CardBorder}" Padding="16,12" Margin="0,12,0,0">
            <StackPanel>
              <TextBlock Text="Using the most memory" FontWeight="SemiBold"/>
              <!-- R5: ranked by private bytes, which a clean does not change, so the order holds after a clean. -->
              <TextBlock x:Name="TopAppsNote" Style="{StaticResource Small}" Text="Ranked by private memory. Cleaning does not shrink it; closing the app does."/>
              <!-- Column heads over the figures; each row's name and tooltip say the same in words. -->
              <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="80"/>
                  <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Style="{StaticResource Small}" HorizontalAlignment="Right" Text="In RAM"/>
                <TextBlock Grid.Column="2" Style="{StaticResource Small}" HorizontalAlignment="Right" Text="Private"/>
              </Grid>
              <app:GroupPanel x:Name="TopList" Margin="0,2,0,0" AutomationProperties.Name="Apps using the most memory">
                <TextBlock Style="{StaticResource Muted}" Text="Reading apps..."/>
              </app:GroupPanel>
            </StackPanel>
          </Border>

          <!-- 5. Auto-clean -->
          <Border Style="{StaticResource CardBorder}" Padding="16,10" Margin="0,8,0,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Auto-clean" FontWeight="SemiBold"/>
                <TextBlock x:Name="AutoDescription" Style="{StaticResource Small}" Text="When load reaches 85%"/>
                <!-- Why automatic cleans wait: admin rights, the user's pause (with Resume), the system (P5) or the
                     back-off (R2, two lines with a warning glyph). -->
                <app:LiveRegion x:Name="AutoStatusRegion" Margin="0,2,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite">
                  <StackPanel x:Name="AutoStatusLine">
                    <DockPanel>
                      <Path x:Name="AutoStatusGlyph" DockPanel.Dock="Left" Style="{StaticResource IconPath}" VerticalAlignment="Top"
                            Margin="0,0,6,0" Visibility="Collapsed"/>
                      <Button x:Name="AutoResumeButton" DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Resume"
                              Margin="8,-4,0,0" VerticalAlignment="Top" Visibility="Collapsed" AutomationProperties.Name="Resume auto-clean"/>
                      <TextBlock x:Name="AutoStatus" Style="{StaticResource Small}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock x:Name="AutoStatusDetail" Style="{StaticResource Small}" Visibility="Collapsed"/>
                  </StackPanel>
                </app:LiveRegion>
              </StackPanel>
              <CheckBox x:Name="AutoSwitch" Grid.Column="1" Style="{StaticResource SwitchStyle}" Margin="12,0,0,0"
                        VerticalAlignment="Center" AutomationProperties.Name="Auto-clean"/>
            </Grid>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <!-- ============================== Startup ============================== -->
    <TabItem x:Name="StartupTab" AutomationProperties.Name="Startup" ToolTip="Startup (Ctrl+2)" AutomationProperties.AcceleratorKey="Ctrl+2">
      <TabItem.Header>
        <StackPanel Orientation="Horizontal">
          <Path Style="{StaticResource IconPath}" Data="{StaticResource IconPower}" Margin="0,0,8,0"
                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
          <TextBlock Text="Startup" VerticalAlignment="Center"/>
        </StackPanel>
      </TabItem.Header>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="16,12,16,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border BorderThickness="1" CornerRadius="4" BorderBrush="{DynamicResource ControlBorder}" Background="{DynamicResource Card}">
              <app:GroupPanel Orientation="Horizontal" AutomationProperties.Name="Show">
                <RadioButton x:Name="ShowAppsButton" GroupName="StartupKind" Style="{StaticResource SegmentStyle}" IsChecked="True"
                             AutomationProperties.Name="Startup apps">
                  <TextBlock><Run Text="Apps"/><Run x:Name="AppsCount" Text="" Foreground="{DynamicResource MutedText}" FontWeight="Normal"/></TextBlock>
                </RadioButton>
                <RadioButton x:Name="ShowServicesButton" GroupName="StartupKind" Style="{StaticResource SegmentStyle}"
                             AutomationProperties.Name="Services">
                  <TextBlock><Run Text="Services"/><Run x:Name="ServicesCount" Text="" Foreground="{DynamicResource MutedText}" FontWeight="Normal"/></TextBlock>
                </RadioButton>
              </app:GroupPanel>
            </Border>
            <Grid Grid.Column="1" Margin="8,0,0,0">
              <TextBox x:Name="StartupSearch" Style="{StaticResource SearchBox}" Tag="Search (Ctrl+F)" Height="36"
                       AutomationProperties.Name="Search startup items" AutomationProperties.AcceleratorKey="Ctrl+F"/>
              <Path Style="{StaticResource IconPath}" Data="{StaticResource IconSearch}" Stroke="{DynamicResource MutedText}"
                    HorizontalAlignment="Left" Margin="9,0,0,0" IsHitTestVisible="False"/>
              <!-- U16: shown only while there is text; Esc in the box does the same and keeps focus there. -->
              <Button x:Name="ClearSearchButton" Style="{StaticResource SubtleButton}" HorizontalAlignment="Right" Width="28" Height="28"
                      Margin="0,0,4,0" Visibility="Collapsed" ToolTip="Clear search (Esc)" AutomationProperties.Name="Clear search">
                <Path Style="{StaticResource IconPath}" Data="{StaticResource IconClose}" Stroke="{DynamicResource Text}"/>
              </Button>
            </Grid>
          </Grid>
          <!-- U9: read out once, when the first load finishes. -->
          <app:LiveRegion x:Name="StartupSummaryRegion" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite"
                          AutomationProperties.Name="Reading what starts with Windows...">
            <TextBlock x:Name="StartupSummary" Style="{StaticResource Small}" Text="Reading what starts with Windows..."/>
          </app:LiveRegion>
          <WrapPanel Margin="0,8,0,0">
            <TextBlock Text="Show" VerticalAlignment="Center" FontSize="13" Margin="0,0,8,4"/>
            <ComboBox x:Name="VerdictBox" Width="200" Margin="0,0,16,4" AutomationProperties.Name="Show verdict"/>
            <TextBlock Text="Sort" VerticalAlignment="Center" FontSize="13" Margin="0,0,8,4"/>
            <ComboBox x:Name="SortBox" Width="110" Margin="0,0,16,4" AutomationProperties.Name="Sort by"/>
            <!-- U9: "12 shown" while a search or filter narrows the list, read out 300 ms after the last change. -->
            <app:LiveRegion x:Name="SearchCountRegion" VerticalAlignment="Center" Margin="0,0,0,4" Visibility="Collapsed"
                            AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Shown">
              <TextBlock x:Name="SearchCount" Style="{StaticResource Small}"/>
            </app:LiveRegion>
          </WrapPanel>
          <app:LiveRegion x:Name="StartupErrorRegion" Visibility="Collapsed" Margin="0,8,0,0"
                          AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Some entries could not be read">
            <TextBlock x:Name="StartupError" TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Danger}"/>
          </app:LiveRegion>
        </StackPanel>
        <ScrollViewer x:Name="StartupView" Grid.Row="1" Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="16,8,16,16">
            <!-- Loading: about a second while Windows lists the services -->
            <app:GroupPanel x:Name="StartupLoading" AutomationProperties.Name="Loading startup items">
              <TextBlock Style="{StaticResource Small}" Text="Reading apps and services, about a second"/>
              <Border Style="{StaticResource Skeleton}" Width="260"/>
              <Border Style="{StaticResource Skeleton}" Width="190"/>
              <Border Style="{StaticResource Skeleton}" Width="230"/>
            </app:GroupPanel>
            <Border x:Name="StartupCard" Style="{StaticResource CardBorder}" Visibility="Collapsed">
              <app:GroupPanel x:Name="StartupList" AutomationProperties.Name="Startup items"/>
            </Border>
            <!-- Empty: nothing in this list, or nothing matches the search and filter. Read out through the search
                 debounce (U9), not on every rebuild. -->
            <app:LiveRegion x:Name="StartupEmptyRegion" HorizontalAlignment="Center" AutomationProperties.LiveSetting="Polite"
                            Visibility="Collapsed">
              <StackPanel x:Name="StartupEmpty" Margin="0,24,0,0">
                <Path Style="{StaticResource IconPath}" Data="{StaticResource IconEmpty}" Stroke="{DynamicResource MutedText}"
                      HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                  <Path.RenderTransform>
                    <ScaleTransform ScaleX="2" ScaleY="2"/>
                  </Path.RenderTransform>
                </Path>
                <TextBlock x:Name="StartupEmptyTitle" Margin="0,20,0,0" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center"/>
                <TextBlock x:Name="StartupEmptyText" Style="{StaticResource Small}" Margin="0,2,0,0" HorizontalAlignment="Center" TextAlignment="Center"/>
              </StackPanel>
            </app:LiveRegion>
            <TextBlock x:Name="StartupNote" Style="{StaticResource Small}" Margin="4,10,4,0"/>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </TabItem>

    <!-- ============================== Settings ============================== -->
    <TabItem x:Name="SettingsTab" AutomationProperties.Name="Settings" ToolTip="Settings (Ctrl+3)" AutomationProperties.AcceleratorKey="Ctrl+3">
      <TabItem.Header>
        <StackPanel Orientation="Horizontal">
          <Path Style="{StaticResource IconPath}" Data="{StaticResource IconSliders}" Margin="0,0,8,0"
                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
          <TextBlock Text="Settings" VerticalAlignment="Center"/>
        </StackPanel>
      </TabItem.Header>
      <ScrollViewer x:Name="SettingsView" Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16,0,16,16">
          <!-- Assertive (U9): settings are not being saved. -->
          <app:LiveRegion x:Name="SaveErrorRegion" Visibility="Collapsed" Margin="0,12,0,0"
                          AutomationProperties.LiveSetting="Assertive" AutomationProperties.Name="Settings not saved">
            <TextBlock x:Name="SaveError" TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Danger}"/>
          </app:LiveRegion>

          <!-- Auto-clean -->
          <TextBlock Text="Auto-clean" Style="{StaticResource SectionHeading}"/>
          <Border Style="{StaticResource CardBorder}">
            <StackPanel>
              <Grid Margin="16,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="Clean automatically"/>
                  <TextBlock x:Name="CooldownText" Style="{StaticResource Small}" Text="At most every 5 minutes"/>
                </StackPanel>
                <CheckBox x:Name="SettingsAutoSwitch" Grid.Column="1" Style="{StaticResource SwitchStyle}" Margin="12,0,0,0"
                          VerticalAlignment="Center" AutomationProperties.Name="Clean automatically"/>
              </Grid>
              <!-- Pause (P6): collapsed while auto-clean is off or needs admin, so there is never a disabled button. One
                   button that reads Pause or Resume, so keyboard focus stays on it across the swap. -->
              <Border x:Name="PauseRow" Style="{StaticResource RowDivider}" Padding="16,10" Visibility="Collapsed">
                <DockPanel>
                  <Button x:Name="PauseButton" DockPanel.Dock="Right" Style="{StaticResource OutlineButton}" Content="Pause for 1 hour"
                          Margin="12,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="Pause for 1 hour"
                          AutomationProperties.HelpText="Pause automatic cleans. Manual cleans still work."/>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Pause automatic cleans" TextWrapping="Wrap"/>
                    <TextBlock x:Name="PauseNote" Style="{StaticResource Small}" Text="Manual cleans still work."/>
                  </StackPanel>
                </DockPanel>
              </Border>
              <Border Style="{StaticResource RowDivider}" Padding="16,10">
                <StackPanel>
                  <TextBlock Text="When memory load reaches"/>
                  <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="ThresholdSlider" Minimum="50" Maximum="99" SmallChange="1" LargeChange="5"
                            IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"
                            AutomationProperties.Name="Clean when memory load reaches, percent"/>
                    <Border Grid.Column="1" Margin="12,0,0,0" MinWidth="52" Height="32" BorderThickness="1" CornerRadius="4"
                            BorderBrush="{DynamicResource ControlBorder}" Background="{DynamicResource Card}">
                      <TextBlock x:Name="ThresholdValue" Style="{StaticResource FigureText}" HorizontalAlignment="Center" Text="85%"/>
                    </Border>
                  </Grid>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource RowDivider}" Padding="16,10">
                <DockPanel>
                  <ComboBox x:Name="IntervalBox" DockPanel.Dock="Right" Width="170" AutomationProperties.Name="Also clean on a schedule"/>
                  <TextBlock Text="Also clean on a schedule" VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap"/>
                </DockPanel>
              </Border>
            </StackPanel>
          </Border>

          <!-- What to clean: the common four, then the rest behind a disclosure -->
          <TextBlock Text="What to clean" Style="{StaticResource SectionHeading}"/>
          <Border Style="{StaticResource CardBorder}" Padding="16,4">
            <StackPanel>
              <CheckBox x:Name="AreaWorkingSets" Margin="0,8" VerticalContentAlignment="Top" AutomationProperties.Name="Process working sets">
                <StackPanel>
                  <TextBlock Text="Process working sets"/>
                  <TextBlock Style="{StaticResource Small}" Text="Biggest drop in use; apps pause briefly as they reload"/>
                </StackPanel>
              </CheckBox>
              <CheckBox x:Name="AreaFileCache" Margin="0,8" VerticalContentAlignment="Top" AutomationProperties.Name="System file cache">
                <StackPanel>
                  <TextBlock Text="System file cache"/>
                  <TextBlock Style="{StaticResource Small}" Text="Recently read files are read from disk again"/>
                </StackPanel>
              </CheckBox>
              <CheckBox x:Name="AreaStandbyLow" Margin="0,8" VerticalContentAlignment="Top" AutomationProperties.Name="Low-priority standby">
                <StackPanel>
                  <TextBlock Text="Low-priority standby"/>
                  <TextBlock Style="{StaticResource Small}" Text="Small effect, small cost"/>
                </StackPanel>
              </CheckBox>
              <CheckBox x:Name="AreaStandby" Margin="0,8" VerticalContentAlignment="Top" AutomationProperties.Name="Full standby cache">
                <StackPanel>
                  <TextBlock Text="Full standby cache"/>
                  <TextBlock Style="{StaticResource Small}" Text="Apps and files load slower until it refills"/>
                </StackPanel>
              </CheckBox>
              <Expander x:Name="MoreAreas" Style="{StaticResource Disclosure}" Margin="0,2,0,6" Header="Show 4 more areas"
                        AutomationProperties.Name="More areas">
                <StackPanel Margin="0,4,0,0">
                  <CheckBox x:Name="AreaModified" Margin="0,8" VerticalContentAlignment="Top" AutomationProperties.Name="Modified pages">
                    <StackPanel>
                      <TextBlock Text="Modified pages"/>
                      <TextBlock Style="{StaticResource Small}" Text="Writes changed pages to disk first, then frees them"/>
                    </StackPanel>
                  </CheckBox>
                  <CheckBox x:Name="AreaVolumes" Margin="0,8" VerticalContentAlignment="Top" AutomationProperties.Name="Drive write cache">
                    <StackPanel>
                      <TextBlock Text="Drive write cache"/>
                      <TextBlock Style="{StaticResource Small}" Text="Writes cached data out to every drive"/>
                    </StackPanel>
                  </CheckBox>
                  <CheckBox x:Name="AreaCombine" Margin="0,8" VerticalContentAlignment="Top" AutomationProperties.Name="Combine identical pages">
                    <StackPanel>
                      <TextBlock Text="Combine identical pages"/>
                      <TextBlock Style="{StaticResource Small}" Text="Keeps one copy of duplicate pages; costs a moment of CPU"/>
                    </StackPanel>
                  </CheckBox>
                  <CheckBox x:Name="AreaRegistry" Margin="0,8" VerticalContentAlignment="Top" AutomationProperties.Name="Registry cache">
                    <StackPanel>
                      <TextBlock Text="Registry cache"/>
                      <TextBlock Style="{StaticResource Small}" Text="Small effect"/>
                    </StackPanel>
                  </CheckBox>
                </StackPanel>
              </Expander>
              <!-- U21: the last selected area stays focusable; unticking it is refused and this line says why, aloud. -->
              <app:LiveRegion x:Name="AreaReasonRegion" Margin="0,0,0,8" Visibility="Collapsed"
                              AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="At least one area must stay selected.">
                <TextBlock x:Name="AreaReason" Style="{StaticResource Small}" Text="At least one area must stay selected."/>
              </app:LiveRegion>
            </StackPanel>
          </Border>

          <!-- Power Clean: services are filled in from AppShell -->
          <TextBlock Text="Power Clean" Style="{StaticResource SectionHeading}"/>
          <Border Style="{StaticResource CardBorder}">
            <StackPanel>
              <Grid Margin="16,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="Use Power Clean"/>
                  <TextBlock Style="{StaticResource Small}"
                             Text="Clean memory then cleans every area and stops the services ticked below. Their startup settings are not changed."/>
                </StackPanel>
                <CheckBox x:Name="SettingsPowerSwitch" Grid.Column="1" Style="{StaticResource SwitchStyle}" Margin="12,0,0,0"
                          VerticalAlignment="Center" AutomationProperties.Name="Use Power Clean"/>
              </Grid>
              <Border Style="{StaticResource RowDivider}" Padding="16,4">
                <Expander x:Name="PowerServices" Style="{StaticResource Disclosure}" Margin="0,4" Header="Services to stop"
                          AutomationProperties.Name="Services to stop">
                  <app:GroupPanel x:Name="PowerList" Margin="0,4,0,0" AutomationProperties.Name="Services to stop">
                    <TextBlock Style="{StaticResource Muted}" Margin="0,6" Text="Reading services..."/>
                  </app:GroupPanel>
                </Expander>
              </Border>
              <Border Style="{StaticResource RowDivider}" Padding="16,10">
                <StackPanel>
                  <Button x:Name="RestoreButton" Style="{StaticResource OutlineButton}" HorizontalAlignment="Left"
                          Content="Restore services" AutomationProperties.Name="Restore services"/>
                  <!-- U9: read out when a restore finishes. -->
                  <app:LiveRegion x:Name="PowerStatusRegion" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite"
                                  AutomationProperties.Name="Services">
                    <TextBlock x:Name="PowerStatus" Style="{StaticResource Small}"/>
                  </app:LiveRegion>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <!-- App -->
          <TextBlock Text="App" Style="{StaticResource SectionHeading}"/>
          <Border Style="{StaticResource CardBorder}">
            <StackPanel>
              <DockPanel Margin="16,10">
                <ComboBox x:Name="ThemeBox" DockPanel.Dock="Right" Width="170" AutomationProperties.Name="Theme"/>
                <TextBlock Text="Theme" VerticalAlignment="Center" Margin="0,0,12,0"/>
              </DockPanel>
              <!-- High contrast overrides the choice above -->
              <TextBlock x:Name="ThemeNote" Style="{StaticResource Small}" Margin="16,-4,16,10" TextWrapping="Wrap" Visibility="Collapsed"/>
              <Border Style="{StaticResource RowDivider}" Padding="16,10">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Start with Windows"/>
                    <TextBlock Style="{StaticResource Small}" Text="Opens in the tray at sign-in, as administrator"/>
                    <TextBlock x:Name="StartupReason" Style="{StaticResource Small}" Visibility="Collapsed"/>
                  </StackPanel>
                  <CheckBox x:Name="StartupCheck" Grid.Column="1" Style="{StaticResource SwitchStyle}" Margin="12,0,0,0"
                            ToolTipService.ShowOnDisabled="True" VerticalAlignment="Center" AutomationProperties.Name="Start with Windows"/>
                </Grid>
              </Border>
              <Border Style="{StaticResource RowDivider}" Padding="16,10">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Close button hides to the tray" VerticalAlignment="Center" TextWrapping="Wrap"/>
                  <CheckBox x:Name="CloseToTrayCheck" Grid.Column="1" Style="{StaticResource SwitchStyle}" Margin="12,0,0,0"
                            VerticalAlignment="Center" AutomationProperties.Name="Close button hides to the tray"/>
                </Grid>
              </Border>
              <Border Style="{StaticResource RowDivider}" Padding="16,10">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Show the load percent on the tray icon" VerticalAlignment="Center" TextWrapping="Wrap"/>
                  <CheckBox x:Name="TrayPercentCheck" Grid.Column="1" Style="{StaticResource SwitchStyle}" Margin="12,0,0,0"
                            VerticalAlignment="Center" AutomationProperties.Name="Show the load percent on the tray icon"/>
                </Grid>
              </Border>
              <!-- R6: opt-in Windows notifications, off by default (owner decision 2026-11-17). -->
              <Border Style="{StaticResource RowDivider}" Padding="16,10">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Notify me when auto-clean has a problem" TextWrapping="Wrap"/>
                    <TextBlock Style="{StaticResource Small}"
                               Text="A Windows notification when an automatic clean fails or stops helping. Never for routine cleans."/>
                  </StackPanel>
                  <CheckBox x:Name="NotifyCheck" Grid.Column="1" Style="{StaticResource SwitchStyle}" Margin="12,0,0,0"
                            VerticalAlignment="Center" AutomationProperties.Name="Notify me when auto-clean has a problem"
                            AutomationProperties.HelpText="A Windows notification when an automatic clean fails or stops helping. Never for routine cleans."/>
                </Grid>
              </Border>
              <!-- R7: the global Clean memory shortcut, none by default. The box records a combination: Delete removes it,
                   Esc leaves it as it was, Tab moves on. Errors and the AltGr warning show under the row, read out politely. -->
              <Border Style="{StaticResource RowDivider}" Padding="16,10">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="Shortcut for Clean memory" TextWrapping="Wrap"/>
                      <TextBlock x:Name="HotkeyNote" Style="{StaticResource Small}"
                                 Text="Works anywhere in Windows while RAM Optimiser runs as administrator. Use two of Ctrl, Alt and Shift with a letter, digit or F key."/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                      <TextBox x:Name="HotkeyBox" Width="150" IsReadOnly="True" Tag="None" IsUndoEnabled="False"
                               AutomationProperties.Name="Shortcut for Clean memory"
                               AutomationProperties.HelpText="Press a key combination. Press Delete to remove the shortcut."/>
                      <Button x:Name="HotkeyRemove" Style="{StaticResource LinkButton}" Content="Remove" HorizontalAlignment="Right"
                              Margin="0,4,0,0" Visibility="Collapsed" AutomationProperties.Name="Remove shortcut"/>
                    </StackPanel>
                  </Grid>
                  <app:LiveRegion x:Name="HotkeyMessageRegion" Margin="0,6,0,0" Visibility="Collapsed"
                                  AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Shortcut">
                    <TextBlock x:Name="HotkeyMessage" Style="{StaticResource Small}" Foreground="{DynamicResource Text}"/>
                  </app:LiveRegion>
                </StackPanel>
              </Border>
              <!-- P16: reset, with the confirmation inline (no dialog). Focus goes to Cancel, the safe choice. -->
              <Border Style="{StaticResource RowDivider}" Padding="16,10">
                <StackPanel>
                  <DockPanel>
                    <Button x:Name="ResetButton" DockPanel.Dock="Right" Style="{StaticResource OutlineButton}" Content="Reset"
                            Margin="12,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="Reset settings"/>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="Reset settings" TextWrapping="Wrap"/>
                      <TextBlock Style="{StaticResource Small}"
                                 Text="Puts every setting back to its default and turns auto-clean off. Start with Windows is left as it is."/>
                    </StackPanel>
                  </DockPanel>
                  <app:GroupPanel x:Name="ResetConfirm" Margin="0,10,0,0" Visibility="Collapsed" AutomationProperties.Name="Confirm reset">
                    <TextBlock Style="{StaticResource Small}" Foreground="{DynamicResource Text}" Text="Reset all settings? This cannot be undone."/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                      <Button x:Name="ResetYes" Style="{StaticResource OutlineButton}" Content="Reset settings"
                              AutomationProperties.Name="Yes, reset settings"/>
                      <Button x:Name="ResetNo" Style="{StaticResource OutlineButton}" Content="Cancel" Margin="8,0,0,0"
                              AutomationProperties.Name="Cancel reset"/>
                    </StackPanel>
                  </app:GroupPanel>
                  <app:LiveRegion x:Name="ResetStatusRegion" Margin="0,8,0,0" Visibility="Collapsed"
                                  AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Settings were reset.">
                    <TextBlock x:Name="ResetStatus" Style="{StaticResource Small}" Foreground="{DynamicResource Text}"/>
                  </app:LiveRegion>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <!-- Activity: this session's cleans and auto-clean events, from memory (the app never reads cleans.log back) -->
          <TextBlock Text="Activity" Style="{StaticResource SectionHeading}"/>
          <Border Style="{StaticResource CardBorder}">
            <StackPanel>
              <Border Padding="16,4">
                <Expander x:Name="RecentCleans" Style="{StaticResource Disclosure}" Margin="0,4" Header="Recent cleans"
                          AutomationProperties.Name="Recent cleans">
                  <app:GroupPanel x:Name="RecentCleanRows" Margin="0,4,0,6" AutomationProperties.Name="Recent cleans"/>
                </Expander>
              </Border>
              <Border Style="{StaticResource RowDivider}" Padding="16,4">
                <Expander x:Name="ActivityList" Style="{StaticResource Disclosure}" Margin="0,4" Header="Recent activity"
                          AutomationProperties.Name="Recent activity">
                  <app:GroupPanel x:Name="ActivityRows" Margin="0,4,0,6" AutomationProperties.Name="Recent activity"/>
                </Expander>
              </Border>
              <Border Style="{StaticResource RowDivider}" Padding="16,10">
                <StackPanel>
                  <TextBlock Text="Clean log file"/>
                  <!-- Selectable, never opened from here: the app may run as administrator (README, Security). -->
                  <TextBox x:Name="ActivityPath" IsReadOnly="True" IsReadOnlyCaretVisible="True" Margin="-3,2,0,0" Padding="0,4"
                           Height="Auto" TextWrapping="Wrap" FontSize="12" Background="Transparent" BorderBrush="Transparent"
                           AutomationProperties.Name="Clean log file"/>
                  <TextBlock x:Name="ActivityPathNote" Style="{StaticResource Small}" Margin="0,2,0,0"
                             Text="Every clean the app runs is added to this file, kept under 256 KB with one older copy. The lists above show this session only."/>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
  </TabControl>
</Window>
