<!-- design.md tokens (redesign 2, option A "Windows native"), dark. Same keys as Light.xaml (a test checks they match). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="Surface" Color="#202020"/>
  <SolidColorBrush x:Key="Card" Color="#2B2B2B"/>
  <SolidColorBrush x:Key="Hairline" Color="#3B3B3B"/>
  <SolidColorBrush x:Key="WindowBorder" Color="#444444"/>
  <SolidColorBrush x:Key="ControlBorder" Color="#9A9A9A"/>
  <SolidColorBrush x:Key="Text" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="MutedText" Color="#C8C8C8"/>
  <SolidColorBrush x:Key="DisabledText" Color="#C8C8C8"/>
  <SolidColorBrush x:Key="Accent" Color="#60CDFF"/>
  <SolidColorBrush x:Key="OnAccent" Color="#101010"/>
  <SolidColorBrush x:Key="TrackBackground" Color="#333333"/>
  <!-- A track's own edge: the fill colour here, window text in high contrast, where the fill matches the card. -->
  <SolidColorBrush x:Key="TrackEdge" Color="#333333"/>
  <SolidColorBrush x:Key="SecondaryButton" Color="#333333"/>
  <SolidColorBrush x:Key="Ok" Color="#6CCB5F"/>
  <SolidColorBrush x:Key="Caution" Color="#FCE100"/>
  <SolidColorBrush x:Key="Danger" Color="#FF99A4"/>
  <SolidColorBrush x:Key="DangerBackground" Color="#442726"/>
  <SolidColorBrush x:Key="InfoBackground" Color="#1F2D3A"/>
  <SolidColorBrush x:Key="InfoBorder" Color="#34506A"/>
  <SolidColorBrush x:Key="FocusRing" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="MapInUse" Color="#60CDFF"/>
  <DrawingBrush x:Key="MapModified" TileMode="Tile" Viewport="0,0,5,5" ViewportUnits="Absolute" Viewbox="0,0,5,5" ViewboxUnits="Absolute">
    <DrawingBrush.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="#2B2B2B" Geometry="M0,0 H5 V5 H0 Z"/>
        <GeometryDrawing Geometry="M-1,6 L6,-1 M-1,1 L1,-1 M4,6 L6,4">
          <GeometryDrawing.Pen>
            <Pen Brush="#60CDFF" Thickness="1.5"/>
          </GeometryDrawing.Pen>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingBrush.Drawing>
  </DrawingBrush>
  <SolidColorBrush x:Key="MapStandby" Color="#1F4A63"/>
  <SolidColorBrush x:Key="MapFree" Color="#2B2B2B"/>
</ResourceDictionary>
